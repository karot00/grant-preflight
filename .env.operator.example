# Local operator mode only. Copy this file to .env.operator and fill in values.
# Never commit .env.operator or private key files.

APP_MODE=operator
AI_MODE=live
STORAGE_MODE=snowflake
APP_BASE_URL=https://grant-preflight.karotammela.fi

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Account identifier without .snowflakecomputing.com.
# Preferred form is organization-account, for example myorg-myaccount.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=GRANT_PREFLIGHT_SERVICE
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

SNOWFLAKE_DATABASE=GRANT_PREFLIGHT
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_WAREHOUSE=GRANT_PREFLIGHT_WH
SNOWFLAKE_ROLE=GRANT_PREFLIGHT_APP
